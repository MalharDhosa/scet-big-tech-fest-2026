rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Event logos - readable by everyone, writable only by master admins
    match /event-logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "master";
    }

    // Event posters - readable by everyone, writable only by master admins
    match /event-posters/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "master";
    }

    // Team member photos - readable by everyone, writable by any authenticated user
    // (admin UI is already role-protected, and photos are non-sensitive)
    match /team-photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
